<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================ Bluetooth ============================ -->
    <!-- Android 12+ (API 31+). neverForLocation lets us skip the location
         permission entirely: we connect to a known MAC, we never use BLE
         results to derive position. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <!-- Android 11 and below (API <= 30): the old model, where a BLE scan is
         gated behind location. maxSdkVersion keeps these off modern devices. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- ========================= Backup copies ========================== -->
    <!-- Documents/CoffeeApp holds the mirrored history DB and logs, so they
         outlive an uninstall. Android 10+ needs no permission for our own
         files there (MediaStore); this covers 9 and below only. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- ====================== Keeping a shot alive ======================= -->
    <!-- The shot logic needs a process that does not sleep, so it runs in a
         foreground service: without it, BLE
         notifications are throttled and the process is killable mid-shot,
         which would strand brew-by-weight with the machine still pouring. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ========================= La Marzocco cloud ======================= -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:name=".CoffeeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoffeeApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CoffeeApp">

            <!-- Android 16 (targetSdk 36) ignores screenOrientation on any
                 display >= sw600dp, so a tablet would rotate this app freely.
                 The portrait lock is deliberate: the brew screen is a
                 one-column live readout meant to sit next to the machine.
                 Temporary - the opt-out stops working at targetSdk 37. -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".core.CoffeeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
